@ECHO OFF
IF EXIST NEO.OBJ DEL NEO.OBJ
IF EXIST NEOCMD.OBJ DEL NEOCMD.OBJ
IF EXIST NEOTST.OBJ DEL NEOTST.OBJ
IF EXIST NEO.COM DEL NEO.COM
IF EXIST NEOTST.COM DEL NEOTST.COM
IF EXIST NEO.MAP DEL NEO.MAP
IF EXIST BUILD.LOG DEL BUILD.LOG
TASM /ml NEO.ASM > BUILD.LOG
IF ERRORLEVEL 1 GOTO BADASM
ECHO TASM_OK>> BUILD.LOG
TCC -mt -c -f- -G- -N- -a- NEOCMD.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO BADC
TCC -mt -c -f- -G- -N- -a- NEOTST.C >> BUILD.LOG
IF ERRORLEVEL 1 GOTO BADC
ECHO TCC_OK>> BUILD.LOG
TLINK /t /m NEO.OBJ NEOCMD.OBJ, NEO.COM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO BADLNK
TLINK /t NEO.OBJ NEOTST.OBJ, NEOTST.COM; >> BUILD.LOG
IF ERRORLEVEL 1 GOTO BADLNK
ECHO LINK_OK>> BUILD.LOG
NEOTST > NEO.LOG
IF ERRORLEVEL 1 GOTO BADTST
ECHO TEST_OK>> BUILD.LOG
DIR NEO.COM >> BUILD.LOG
DIR NEOTST.COM >> BUILD.LOG
GOTO END
:BADASM
ECHO TASM_FAIL>> BUILD.LOG
GOTO END
:BADC
ECHO TCC_FAIL>> BUILD.LOG
GOTO END
:BADLNK
ECHO LINK_FAIL>> BUILD.LOG
GOTO END
:BADTST
ECHO TEST_FAIL>> BUILD.LOG
:END
