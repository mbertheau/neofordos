@ECHO OFF
DEL NEO.OBJ
DEL NEO.COM
DEL BUILD.LOG
C:\TASM\TASM /ml NEO.ASM > BUILD.LOG
IF ERRORLEVEL 1 GOTO BADASM
ECHO TASM_OK>> BUILD.LOG
C:\TASM\TLINK /t NEO.OBJ >> BUILD.LOG
IF ERRORLEVEL 1 GOTO BADLNK
ECHO LINK_OK>> BUILD.LOG
NEO /T > NEO.LOG
IF ERRORLEVEL 1 GOTO BADTST
ECHO TEST_OK>> BUILD.LOG
DIR NEO.COM >> BUILD.LOG
GOTO END
:BADASM
ECHO TASM_FAIL>> BUILD.LOG
GOTO END
:BADLNK
ECHO LINK_FAIL>> BUILD.LOG
GOTO END
:BADTST
ECHO TEST_FAIL>> BUILD.LOG
:END
